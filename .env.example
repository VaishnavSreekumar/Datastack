# ==============================================================================
# DataStack Environment Configuration Template
# Copy this file to .env and customize values for your local environment.
# DO NOT COMMIT THE ACTUAL .env FILE TO VERSION CONTROL.
# ==============================================================================

# PostgreSQL Warehouse Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=olist_dw
POSTGRES_USER=olist
POSTGRES_PASSWORD=olist_secure_dev_password
POSTGRES_SCHEMA_DEV=dev
POSTGRES_SCHEMA_PROD=public

# Docker Compose Settings (Local Port Binding)
DOCKER_POSTGRES_PORT=5434

# Storage Paths (Relative to repository root or absolute paths)
DATA_RAW_DIR=./raw_data
DATA_LAKE_BRONZE_DIR=./data_lake/bronze
DATA_LAKE_SILVER_DIR=./data_lake/silver

# Spark & Java Settings
SPARK_MASTER=local[*]
SPARK_LOG_LEVEL=WARN
POSTGRES_JDBC_JAR=./drivers/postgresql-42.7.3.jar

# Airflow Configuration
AIRFLOW_HOME=./airflow
AIRFLOW_CORE_LOAD_EXAMPLES=False
AIRFLOW_ALERT_EMAIL=
AIRFLOW_ENABLE_EMAIL_ALERTS=False
